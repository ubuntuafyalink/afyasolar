# AfyaSolar AI Engine - example environment. Copy to .env and fill in.
# .env is git-ignored; never commit real tokens.

# HuggingFace access token. NOT needed to download Chronos (it is public,
# Apache-2.0). Needed to PUSH your fine-tuned model to a HF repo and to deploy
# the FastAPI service to a HuggingFace Space. Create at:
# https://huggingface.co/settings/tokens  (scope: Write)
HF_TOKEN=

# Where the fine-tuned predictors and their context datasets live.
# Defaults point at the in-repo pipeline outputs.
AI_ENGINE_MODEL_DIR=
AI_ENGINE_PROCESSED_DIR=
AI_ENGINE_DATA_FORMAT=parquet

# LLM advisory layer (/advisory). OpenAI-compatible chat API; defaults to Groq
# (open-weights models). Leave LLM_API_KEY empty to use the deterministic
# rule-based fallback instead. Get a Groq key at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=30
