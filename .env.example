# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=afya_solar
DB_SSL=false

# NextAuth
NEXTAUTH_SECRET=generate_a_random_secret
NEXTAUTH_URL=http://localhost:3000

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password

# SMS (optional)
SMARTSMS_API_KEY=your_smartsms_api_key

# Twilio WhatsApp (optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# AI (optional). The assistant prefers Gemini when GEMINI_API_KEY is set (via
# Google's OpenAI-compatible endpoint) and falls back to GROQ otherwise.
# GEMINI_MODEL defaults to gemini-2.0-flash.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your_groq_api_key

# Maps (optional). When set, the Climate Outlook location map uses Google Maps
# (marker + Street View) via the free Maps Embed API; otherwise it falls back to
# OpenStreetMap. Must be a NEXT_PUBLIC_ var so the client can read it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_embed_api_key
