# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=afya_solar
DB_SSL=false

# NextAuth
NEXTAUTH_SECRET=generate_a_random_secret
NEXTAUTH_URL=http://localhost:3000

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password

# SMS (optional)
SMARTSMS_API_KEY=your_smartsms_api_key

# Twilio WhatsApp (optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# AI (optional). The assistant prefers Gemini when GEMINI_API_KEY is set (via
# Google's OpenAI-compatible endpoint) and falls back to GROQ otherwise.
# GEMINI_MODEL defaults to gemini-2.0-flash.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your_groq_api_key

# Maps (optional). When set, the Climate Outlook location map uses Google Maps
# (marker + Street View) via the free Maps Embed API; otherwise it falls back to
# OpenStreetMap. Must be a NEXT_PUBLIC_ var so the client can read it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_embed_api_key

# Demo telemetry (default off). When "true", the simulated live-telemetry feed
# (useSimulatedTelemetry) is enabled for demos; otherwise it stays inert so admin
# surfaces only show real device data or an honest empty state.
NEXT_PUBLIC_DEMO_TELEMETRY=false

# Application base URL (used by server-side links / callbacks).
APP_BASE_URL=http://localhost:3000

# Database TLS CA bundle (optional). Path to the CA cert for managed MySQL/TiDB.
DB_CA_PATH=

# Azam Pay (payments). Obtain from the Azam Pay merchant dashboard.
AZAM_PAY_ENVIRONMENT=sandbox
AZAM_PAY_APP_NAME=your_azampay_app_name
AZAM_PAY_CLIENT_ID=your_azampay_client_id
AZAM_PAY_CLIENT_SECRET=your_azampay_client_secret
AZAM_PAY_API_KEY=your_azampay_api_key

# Vercel Blob storage (optional; used for file/report uploads when configured).
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Cron / scheduled-job shared secret. Callers of /api/cron/* must send
# "Authorization: Bearer ${CRON_SECRET}".
CRON_SECRET=generate_a_random_secret

# OpenAI (optional). Schema-compatible fallback for the AI assistant.
OPENAI_API_KEY=your_openai_api_key

# SMS provider selection + SmartSMS details.
# SMS_PROVIDER selects the messaging channel adapter (default "smartsms").
SMS_PROVIDER=smartsms
SMARTSMS_API_URL=https://smartsms.ipab.co.tz/api/v3/sms/send
SMARTSMS_SENDER_ID=your_sender_id

# Web Push (VAPID). Generate with: npm run generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com

# Africa's Talking (optional; primary SMS/USSD/Voice provider once configured).
# When SMS_PROVIDER=africastalking these must be set, otherwise the adapter
# reports "not configured" and the app falls back to SmartSMS.
AFRICASTALKING_USERNAME=your_at_username
AFRICASTALKING_API_KEY=your_at_api_key
AFRICASTALKING_SENDER_ID=your_at_sender_id

# Device telemetry ingestion token. Inverter adapters / gateways authenticate
# to POST /api/devices/telemetry with "Authorization: Bearer ${DEVICE_INGEST_TOKEN}".
DEVICE_INGEST_TOKEN=generate_a_random_device_token
